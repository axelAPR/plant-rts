# Godot 4+ specific ignores
.godot/
/android/

# Sauvegardes automatiques de Blender
*.blend1

# Contenus extraits de Plants vs. Zombies: Garden Warfare 2 (droits EA/PopCap) et
# tout ce qui en dérive : usage personnel en local, jamais publiés (dépôt public).
/blender/plants imp/
/blender/zombies imp/
/blender/addon GW2/
/blender/gw2/
/assets/gw2/
# Captures du HUD : montrent les portraits et cadres extraits de GW2.
/tests/hud_test/captures/

# Cache Python des scripts Blender
__pycache__/

# Pack de textures source fourni par l'utilisateur (les textures utilisées sont
# copiées dans blender/environment/textures/)
/blender/Texture imp/
